<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode. -->
    <style name="Base.Theme.ITANES" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/blue_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/dark_on_primary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/amber_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>

        <!-- Background and surface. -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>

        <!-- Error color. -->
        <item name="colorError">@color/color_error</item>
    </style>
</resources>
