<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ITANES" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/light_on_primary</item>
        <item name="colorPrimaryContainer">@color/blue_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/light_on_primary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/amber_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/blue_primary_dark</item>

        <!-- Background and surface. -->
        <item name="android:windowBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/light_text_secondary</item>

        <!-- Error color. -->
        <item name="colorError">@color/color_error</item>
    </style>

    <style name="Theme.ITANES" parent="Base.Theme.ITANES" />

    <!-- Shape Appearance para imágenes redondeadas -->
    <style name="ShapeAppearance.ITANES.RoundedImage" parent="">
        <item name="cornerSize">20dp</item>
    </style>
</resources>
